APP_ORIGIN=https://ddggdd.tech
APP_NAME=되는날
# Optional. Kakao Developers > 앱 > 플랫폼 키 > JavaScript 키 (32자리).
# Register https://ddggdd.tech as the JavaScript SDK domain first.
# Empty = share falls back to the phone's share sheet / copy link.
KAKAO_JS_KEY=
# Required for calendar linking: 32 random bytes, base64. Keep it; changing it makes saved calendar links unreadable.
# Create with: openssl rand -base64 32
CAL_KEY=
